rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // 誰でも大会結果を閲覧できる（今の公開サイトと同じ扱い）
      allow read: if true;
      // 書き込みはFirebase Authenticationでログイン済みのユーザーのみ
      // （このプロジェクトでは公開の新規登録画面を用意していないため、
      // 実質的にコンソールで手動登録した管理者アカウントだけが該当する）
      allow write: if request.auth != null;
    }
  }
}
